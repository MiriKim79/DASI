# backend/.env 로 복사해서 실제 값을 채운다. .env 자체는 커밋하지 않는다.

# 팀 표준은 MySQL. 비워두면 SQLite(./memory_playground.db)로 동작한다.
DATABASE_URL=sqlite:///./memory_playground.db
# MySQL 사용 시 이 형식으로 교체
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DB_NAME

# 세대별 챗봇(F3-2)이 OpenAI Responses API를 호출하는 데 필요.
OPENAI_API_KEY=
# 기본값 gpt-4o-mini. 필요하면 다른 모델로 교체 가능.
OPENAI_CHAT_MODEL=gpt-4o-mini

# 인증(JWT) — 4번 회원 기능에서 사용
JWT_SECRET=replace_with_a_long_random_value

# API 호출을 허용할 프론트 origin (콤마로 여러 개 가능)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
