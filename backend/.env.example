# Database URL. SQLite is the default for a quick local run.
DATABASE_URL=sqlite:///./memory_playground.db

# For the team-standard MySQL database, replace DATABASE_URL with this format.
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DB_NAME

# External services (keep real values only in backend/.env).
OPENAI_API_KEY=your_openai_api_key
JWT_SECRET=replace_with_a_long_random_value

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
