# backend/.env 로 복사해서 실제 값을 채운다. .env 자체는 커밋하지 않는다.

# 세대별 챗봇(F3-2)이 OpenAI Responses API를 호출하는 데 필요.
OPENAI_API_KEY=
# 기본값 gpt-4o-mini. 필요하면 다른 모델로 교체 가능.
OPENAI_CHAT_MODEL=gpt-4o-mini

# 팀 표준은 MySQL. 비워두면 SQLite(./memory_playground.db)로 동작한다.
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/dasi

# 프론트 개발 서버 주소 (CORS 허용용). 기본값 http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
